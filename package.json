{
  "name": "maut-ka-mahurat",
  "version": "0.1.0",
  "private": true,
  "description": "Maut Ka Mahurat: a Bollywood trivia murder party. Host screen + phone controllers over Socket.io.",
  "main": "server.js",
  "scripts": {
